# ==============================================================================
# Plantilla de Variables de Entorno del Frontend (Vite + React)
# Copia este archivo como .env y ajusta los valores según tu entorno
# ==============================================================================

# URL base del servidor backend de Spring Boot (utilizada por el proxy de desarrollo de Vite)
VITE_BACKEND_URL=http://localhost:8080

# URL base opcional para el cliente HTTP Axios (dejar vacío si se usa el proxy de Vite o el mismo host)
VITE_API_BASE_URL=

# Rutas base de los endpoints REST del backend
VITE_AUTH_BASE_URL=/api/auth
VITE_CUSTOMERS_BASE_URL=/api/customers
VITE_INVOICES_BASE_URL=/api/invoices
VITE_USERS_BASE_URL=/api/users
VITE_ACTUATOR_BASE_URL=/actuator
